{
  "name": "learn-loop-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src worker --ext js,jsx",
    "test": "node tests/auth.test.js && node --test tests/authReturn.test.js && node tests/videoValidation.test.js && node --test tests/proxy.test.js",
    "test:proxy": "node --test tests/proxy.test.js",
    "dev:cloudflare": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "check:cloudflare": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy:cloudflare": "wrangler deploy"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "axios": "^1.20.0",
    "lucide-react": "^0.436.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.2",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.18.4",
    "react-toastify": "^10.0.5",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^7.3.6",
    "wrangler": "4.145.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
